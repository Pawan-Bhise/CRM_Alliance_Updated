@model CallCenterSecure.Models.ViewModels.SurveyFormIndexViewModel

@{
    ViewBag.Title = "Survey Forms";
    var totalForms = Model.Forms.Count;
    var activeForms = Model.Forms.Count(x => x.IsActive);
    var inactiveForms = totalForms - activeForms;
}

<h2 class="mb-3">Survey Forms</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

@using (Html.BeginForm("Index", "SurveyForm", FormMethod.Get, new { @class = "row g-2 mb-4" }))
{
    <div class="col-md-5">
        @Html.Label("Survey Template", htmlAttributes: new { @class = "form-label" })
        @Html.DropDownList("templateId", new SelectList(Model.SurveyTemplates, "Value", "Text", Model.SelectedSurveyTemplateId), "Select a template", new { @class = "form-control", onchange = "this.form.submit();" })
    </div>
    <div class="col-md-7 d-flex align-items-end">
        @if (Model.SelectedSurveyTemplateId.HasValue)
        {
            @Html.RouteLink("Create New Form", "SurveyForm", new { action = "Create", templateId = Model.SelectedSurveyTemplateId.Value }, new { @class = "btn btn-primary me-2" })
        }
        @Html.RouteLink("Back to Templates", "SurveyTemplate", new { action = "Index" }, new { @class = "btn btn-outline-secondary" })
    </div>
}

@if (!Model.SelectedSurveyTemplateId.HasValue)
{
    <div class="alert alert-warning">No survey templates found. Please create a survey template first.</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Total Forms</div>
                    <h3 class="mb-0">@totalForms</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Active</div>
                    <h3 class="mb-0 text-success">@activeForms</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Inactive</div>
                    <h3 class="mb-0 text-secondary">@inactiveForms</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table id="surveyFormTable" class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">#</th>
                        <th>Form Title</th>
                        <th>Category</th>
                        <th>Questions</th>
                        <th>Status</th>
                        <th>Last Updated</th>
                        <th style="width: 280px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Forms)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>
                                <strong>@item.Title</strong>
                                <div class="text-muted small">@item.SurveyTemplateName</div>
                            </td>
                            <td>@item.Category</td>
                            <td>@item.QuestionCount</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>@((item.ModifiedDate ?? item.CreatedDate).ToString("yyyy-MM-dd HH:mm"))</td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    @Html.RouteLink("Edit", "SurveyForm", new { action = "Edit", id = item.Id }, new { @class = "btn btn-outline-primary btn-sm" })

                                    @using (Html.BeginForm("ExportExcel", "SurveyForm", new { id = item.Id }, FormMethod.Get, new { @class = "d-inline" }))
                                    {
                                        <button type="submit" class="btn btn-outline-secondary btn-sm" data-skip-loader="true">Export</button>
                                    }

                                    @using (Html.BeginForm("Duplicate", "SurveyForm", new { id = item.Id, templateId = Model.SelectedSurveyTemplateId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-info btn-sm" onclick="return confirm('Duplicate this survey form?');">Duplicate</button>
                                    }

                                    @using (Html.BeginForm("ToggleStatus", "SurveyForm", new { id = item.Id, templateId = Model.SelectedSurveyTemplateId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-warning btn-sm">@(item.IsActive ? "Disable" : "Enable")</button>
                                    }

                                    @using (Html.BeginForm("Delete", "SurveyForm", new { id = item.Id, templateId = Model.SelectedSurveyTemplateId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this survey form?');">Delete</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($('#surveyFormTable tbody tr').length > 0) {
                $('#surveyFormTable').DataTable({
                    pageLength: 10,
                    order: [],
                    responsive: true
                });
            }
        });
    </script>
}
