@model CallCenterSecure.Models.UploadJob

@{
    ViewBag.Title = "Upload Log";
}

<h2>Upload Log</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">File Name</dt>
            <dd class="col-sm-9">@Model.FileName</dd>

            <dt class="col-sm-3">Uploaded By</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.UploadedBy) ? "System" : Model.UploadedBy)</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Batch Tag</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.BatchTag) ? "-" : Model.BatchTag)</dd>

            <dt class="col-sm-3">Processed Rows</dt>
            <dd class="col-sm-9">@(Model.ProcessedRows ?? 0)</dd>

            <dt class="col-sm-3">Created On</dt>
            <dd class="col-sm-9">@Model.CreatedOn.ToString("yyyy-MM-dd HH:mm:ss")</dd>

            <dt class="col-sm-3">Message</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Message) ? "-" : Model.Message)</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    @Html.ActionLink("Back to Upload", "CustomerDataUpload", "SurveyTemplate", null, new { @class = "btn btn-secondary" })
</div>
