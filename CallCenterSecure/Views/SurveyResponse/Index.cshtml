@model CallCenterSecure.Models.ViewModels.SurveyFormResponseListViewModel

@{
    ViewBag.Title = "Survey Response";
}

<style>
    #surveyCustomerTable {
        width: 100% !important;
        table-layout: fixed;
        font-size: 0.72rem;
    }

    #surveyCustomerTable th,
    #surveyCustomerTable td {
        padding: 0.35rem 0.3rem;
        white-space: normal;
        overflow-wrap: anywhere;
        vertical-align: middle;
    }

    #surveyCustomerTable th:nth-child(1),
    #surveyCustomerTable th:nth-child(2),
    #surveyCustomerTable th:nth-child(3),
    #surveyCustomerTable th:nth-child(4),
    #surveyCustomerTable th:nth-child(5),
    #surveyCustomerTable th:nth-child(6) {
        width: 4.5%;
    }

    #surveyCustomerTable th:nth-child(7),
    #surveyCustomerTable th:nth-child(8),
    #surveyCustomerTable th:nth-child(9),
    #surveyCustomerTable th:nth-child(10),
    #surveyCustomerTable th:nth-child(11),
    #surveyCustomerTable th:nth-child(12) {
        width: 6%;
    }

    #surveyCustomerTable th:nth-child(13),
    #surveyCustomerTable th:nth-child(14),
    #surveyCustomerTable th:nth-child(15),
    #surveyCustomerTable th:nth-child(16),
    #surveyCustomerTable th:nth-child(17),
    #surveyCustomerTable th:nth-child(18) {
        width: 6.16%;
    }

    #surveyCustomerTable .btn-edit-customer {
        font-size: 0.68rem;
        padding: 0.2rem 0.35rem;
    }

    #surveyCustomerTable_wrapper,
    #surveyCustomerTable_wrapper .table-responsive {
        max-width: 100%;
        overflow-x: hidden;
    }
</style>

<h2>Survey Response</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
}

<p class="text-muted">Select a template and form to start filling response.</p>

@if (!string.IsNullOrWhiteSpace(Model.CustomerLookupMessage))
{
    <div class="alert alert-warning" role="alert">@Model.CustomerLookupMessage</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Survey Template</label>
                <select id="templateId" class="form-control">
                    <option value="">Select template</option>
                    @foreach (var item in Model.Templates)
                    {
                        <option value="@item.Id" @(Model.SelectedTemplateId == item.Id ? "selected" : "")>@item.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Survey Form</label>
                <select id="formId" class="form-control">
                    <option value="">Select form</option>
                    @foreach (var item in Model.Forms)
                    {
                        <option value="@item.Id" @(Model.SelectedFormId == item.Id ? "selected" : "")>@item.Title</option>
                    }
                </select>
            </div>
            <input type="hidden" id="customerId" value="@(Model.SelectedCustomerId.HasValue ? Model.SelectedCustomerId.Value.ToString() : "")" />
        </div>

        <div class="mt-3">
            <button type="button" id="btnStartResponse" class="btn btn-primary">Start Response</button>
            @Html.RouteLink("Back to Survey Forms", "SurveyForm", new { action = "Index", templateId = Model.SelectedTemplateId }, new { @class = "btn btn-secondary ms-2" })
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Customers</h5>
            <span id="customerGridMessage" class="text-muted small">Select a survey template to load customers.</span>
        </div>
        <div class="table-responsive">
            <table id="surveyCustomerTable" class="table table-striped table-hover table-bordered w-100">
                <thead>
                    <tr>
                        <th>Select</th>
                        <th>Edit</th>
                        <th>No.</th>
                        <th>Customer Name</th>
                        <th>Gender</th>
                        <th>Product</th>
                        <th>Customer Code</th>
                        <th>Mobile Number 1</th>
                        <th>Mobile Number 2</th>
                        <th>Region/State</th>
                        <th>Branch</th>
                        <th>Business Category</th>
                        <th>Activities/Sector</th>
                        <th>Loan Cycle</th>
                        <th>Disbursed Amount</th>
                        <th>Call Status</th>
                        <th>Form Status</th>
                        <th>Call Remarks</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="customerStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Customer Call Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("UpdateCustomerStatus", "SurveyResponse", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="editCustomerId" name="SurveyCustomerDataId" />
                    <input type="hidden" id="editTemplateId" name="SurveyTemplateTypeId" />
                    <input type="hidden" id="editFormId" name="SurveyFormId" />
                    <div class="mb-3">
                        <label class="form-label" for="editCallStatusId">Call Status</label>
                        <select id="editCallStatusId" name="CallStatusId" class="form-select">
                            <option value="">Select call status</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="editFormStatus">Form Status</label>
                        <input type="text" id="editFormStatus" class="form-control" readonly />
                    </div>
                    <div>
                        <label class="form-label" for="editCallRemarks">Call Remarks</label>
                        <textarea id="editCallRemarks" name="CallRemarks" class="form-control" rows="3" maxlength="1000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/Scripts/survey-response.js")"></script>
}
